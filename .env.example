# Copie para .env.local e preencha. NUNCA versione o .env.local (o repositório é público).

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (sb_publishable_...). Pode ir para o navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). SOMENTE no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Primeira gráfica e SuperAdmin — usados só por `npm run plataforma:iniciar`.
# Depois de rodar, APAGUE o valor de ADMIN_PASSWORD.
ORG_NAME=
ORG_SLUG=
ADMIN_FULL_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
TV_DEVICE_TOKEN_SECRET=
ART_LINK_SIGNING_SECRET=

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE_URL=https://partner.test-stable.shopeemobile.com
SHOPEE_REDIRECT_URL=

# Provedor de NF-e (definir: Focus NFe, NFE.io, PlugNotas...)
NFE_PROVIDER=
NFE_API_TOKEN=
NFE_ENVIRONMENT=homologacao

# Criptografia dos tokens de marketplace
INTEGRATIONS_ENCRYPTION_KEY=

# Vercel Cron
CRON_SECRET=
